<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %msg%n"/>
        </Console>

        <!-- File Appender -->
        <!-- Need imediateFlush=false for Async logging -->
        <!--
        <File name="File" fileName="logs/application.log" imediateFlush="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %msg%n"/>
        </File>
        -->
        <RollingFile name="RollingFile" fileName="logs/photoapp.log"
                     filePattern="logs/photoapp-%d{yyyy-MM-dd}.log"
                     immediateFlush="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Root Logger -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>

        <!-- Custom Logger for a specific package -->
        <!--
        <Logger name="com.example.demo" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <AsyncLogger level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </AsyncLogger>
        -->
    </Loggers>
</Configuration>